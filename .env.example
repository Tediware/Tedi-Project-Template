# Tediware integration. Copy to .env.local and fill in. Never commit .env.local.
#
# Every variable is optional. With none set the app still runs: outbound
# submissions are stubbed as accepted, and inbound webhooks can be exercised
# locally with `npm run webhook:send` (that needs only TEDIWARE_WEBHOOK_SECRET).
# The server prints which capabilities are live at startup.

# Tediware host: scheme and host only, no path. Use your local instance's URL
# if you run one.
TEDIWARE_BASE_URL=https://tediware.com

# API key for the platform API: fetching results and artifacts, submitting
# documents, resending, reading traces and partners. Create one at
# https://tediware.com/app/api-keys. A sandbox-scoped key can fetch results
# and artifacts but cannot submit or list partners.
TEDIWARE_API_KEY=

# Signing secret of the webhook pointed at /api/webhooks/tediware (inbound
# documents). For local testing with `npm run webhook:send`, any value works.
TEDIWARE_WEBHOOK_SECRET=

# Optional. Secrets of the outbound (delivered) and error webhooks, pointed at
# /api/webhooks/tediware/outbound and /api/webhooks/tediware/errors. Each
# Tediware webhook has its own secret; either falls back to
# TEDIWARE_WEBHOOK_SECRET when unset.
# TEDIWARE_OUTBOUND_WEBHOOK_SECRET=
# TEDIWARE_ERROR_WEBHOOK_SECRET=

# Optional. Webhook replay tolerance in seconds (default 300).
# TEDIWARE_WEBHOOK_TOLERANCE_SECONDS=300

# Optional. Where the SQLite file lives (default data/app.db).
# DATABASE_URL=

# Optional. Where `npm run webhook:send` posts (default http://localhost:3000).
# APP_URL=http://localhost:3000
